<?xml version="1.0" encoding="UTF-8"?>
<!-- File types for VFX formats that shared-mime-info doesn't cover (or only
     partly). image/x-exr is already defined upstream, so it isn't repeated. -->
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="model/x-usd">
    <comment>USD scene</comment>
    <icon name="model-x-usd"/>
    <glob pattern="*.usd"/>
    <glob pattern="*.usda"/>
    <glob pattern="*.usdc"/>
    <magic priority="60">
      <match type="string" offset="0" value="#usda"/>
      <match type="string" offset="0" value="PXR-USDC"/>
    </magic>
  </mime-type>
  <mime-type type="model/vnd.usdz+zip">
    <comment>USDZ package</comment>
    <icon name="model-vnd.usdz+zip"/>
    <glob pattern="*.usdz"/>
  </mime-type>
  <mime-type type="application/x-openvdb">
    <comment>OpenVDB volume</comment>
    <icon name="application-x-openvdb"/>
    <glob pattern="*.vdb"/>
  </mime-type>
</mime-info>
