[Icon Theme]
Name=dash-punk
Comment=Isometric icons in the spirit of the IRIX desktop
Inherits=Adwaita,hicolor
Directories=scalable/mimetypes,scalable/apps,scalable/places

[scalable/mimetypes]
Size=128
MinSize=16
MaxSize=512
Context=MimeTypes
Type=Scalable

[scalable/apps]
Size=128
MinSize=16
MaxSize=512
Context=Applications
Type=Scalable

[scalable/places]
Size=128
MinSize=16
MaxSize=512
Context=Places
Type=Scalable
