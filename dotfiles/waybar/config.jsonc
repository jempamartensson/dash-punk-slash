{
  "layer": "top",
  "position": "top",
  "height": 24,
  "spacing": 0,
  "modules-left": ["hyprland/workspaces", "hyprland/window"],
  "modules-right": ["cpu", "memory", "custom/gpu", "pulseaudio", "network", "clock"],
  "hyprland/window": { "max-length": 80 },
  "cpu": { "format": "cpu {usage}%", "interval": 3 },
  "memory": { "format": "mem {used:0.0f}G", "interval": 5 },
  "custom/gpu": {
    "exec": "cat /sys/class/drm/card*/device/gpu_busy_percent 2>/dev/null | head -1",
    "format": "gpu {}%",
    "interval": 3
  },
  "pulseaudio": { "format": "vol {volume}%", "format-muted": "vol mute", "on-click": "pavucontrol" },
  "network": { "format-ethernet": "net up", "format-wifi": "wifi {signalStrength}%", "format-disconnected": "net down" },
  "clock": { "format": "{:%a %d %b  %H:%M}" }
}
