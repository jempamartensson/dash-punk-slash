/* Generated by vfx-theme ({{name}}). Motif-style Qt stylesheet for usdview
   and other PySide tools. Raised = light top-left, dark bottom-right. */
QWidget {
    background: {{chrome}};
    color: {{text}};
    selection-background-color: {{sel}};
    selection-color: {{sel_text}};
    font-family: "Nimbus Sans", "DejaVu Sans", sans-serif;
}
QMainWindow::separator { background: {{lo}}; width: 4px; height: 4px; }

QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox, QDoubleSpinBox,
QTreeView, QTreeWidget, QListView, QTableView, QTableWidget {
    background: {{field}};
    border: 2px solid;
    border-color: {{lo}} {{hi}} {{hi}} {{lo}};
}
QTreeView::item:selected, QListView::item:selected, QTableView::item:selected {
    background: {{sel}};
    color: {{sel_text}};
}
QHeaderView::section {
    background: {{chrome}};
    color: {{muted}};
    padding: 3px 6px;
    border: 1px solid;
    border-color: {{hi}} {{lo}} {{lo}} {{hi}};
}

QPushButton, QToolButton, QComboBox {
    background: {{chrome}};
    border: 2px solid;
    border-color: {{hi}} {{lo}} {{lo}} {{hi}};
    padding: 3px 10px;
}
QPushButton:pressed, QToolButton:pressed, QToolButton:checked, QPushButton:checked {
    background: {{field}};
    border-color: {{lo}} {{hi}} {{hi}} {{lo}};
}
QPushButton:focus, QToolButton:focus { outline: none; border-color: {{wm}}; }
QComboBox QAbstractItemView { background: {{field}}; border: 1px solid {{lo}}; }

QMenuBar { background: {{chrome}}; border-bottom: 1px solid {{lo}}; }
QMenuBar::item:selected, QMenu::item:selected { background: {{sel}}; color: {{sel_text}}; }
QMenu { background: {{chrome}}; border: 2px solid; border-color: {{hi}} {{lo}} {{lo}} {{hi}}; }
QMenu::separator { height: 2px; background: {{lo}}; margin: 3px 6px; }

QTabBar::tab {
    background: {{chrome}};
    border: 2px solid; border-bottom: none;
    border-color: {{hi}} {{lo}} {{lo}} {{hi}};
    padding: 3px 12px;
}
QTabBar::tab:selected { background: {{field}}; }

QScrollBar:vertical, QScrollBar:horizontal { background: {{lo}}; border: none; }
QScrollBar:vertical { width: 14px; }
QScrollBar:horizontal { height: 14px; }
QScrollBar::handle {
    background: {{chrome}};
    border: 2px solid;
    border-color: {{hi}} {{lo}} {{lo}} {{hi}};
    min-height: 20px; min-width: 20px;
}
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; }

QSlider::groove:horizontal { height: 6px; background: {{field}}; border: 1px solid {{lo}}; }
QSlider::handle:horizontal {
    background: {{chrome}}; width: 12px; margin: -6px 0;
    border: 2px solid; border-color: {{hi}} {{lo}} {{lo}} {{hi}};
}
QSlider::sub-page:horizontal { background: {{accent}}; }

QGroupBox { border: 2px solid; border-color: {{lo}} {{hi}} {{hi}} {{lo}}; margin-top: 12px; }
QGroupBox::title { subcontrol-origin: margin; left: 8px; color: {{muted}}; }
QToolTip { background: {{field}}; color: {{text}}; border: 1px solid {{lo}}; }
QStatusBar { border-top: 1px solid {{hi}}; color: {{muted}}; }
